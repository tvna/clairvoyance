server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Runtime config (design §6) -- never cached, so a redeploy with new
    # env is visible without a hard reload.
    location = /ui/config.json {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files /ui/config.json =404;
    }

    # Vite emits content-hashed filenames, so these are safe to cache
    # forever.
    location /ui/assets/ {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA fallback: any /ui/* route not matched above (e.g.
    # /ui/contributors/<id>) serves index.html for client-side routing.
    location /ui/ {
        include /etc/nginx/conf.d/security-headers.conf;
        try_files $uri $uri/ /ui/index.html;
    }
}
