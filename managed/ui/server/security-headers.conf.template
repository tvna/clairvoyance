# Rendered per-boot by entrypoint.sh (envsubst on ISSUER_ORIGIN only) and
# `include`d inside every location block in default.conf.template.
# nginx does NOT inherit server-level add_header into a location that
# defines its own add_header, so this file exists to be repeated
# per-location rather than duplicated by hand (design §9).
add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ${ISSUER_ORIGIN}; frame-ancestors 'none'; script-src 'self'; style-src 'self'; base-uri 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "same-origin" always;
add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
